# ─── InsForge ────────────────────────────────────────────────────────────────
# Project linked in .insforge/project.json (oss_host + ANON_KEY).
# Fetch ANON_KEY: npx @insforge/cli secrets get ANON_KEY
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Server-only admin key. Equivalent to a service role key — never expose to client.
# Mostly unused at runtime; the CLI handles migrations and admin ops.
INSFORGE_API_KEY=

# ─── LLM access (OpenRouter — locked per Q1, 2026-05-05) ─────────────────────
OPENROUTER_API_KEY=

# Anthropic direct. Optional for V1 (OpenRouter is the default LLM gateway).
# REQUIRED for V2 leaf runtime (Managed Agents): the SDK auto-sets the
# `managed-agents-2026-04-01` beta header so no header env var is needed.
# Confirm the key has access to outcomes + multi-agent (research preview); if
# not, request via https://claude.com/form/claude-managed-agents.
ANTHROPIC_API_KEY=

# ─── V2 Managed Agents (set after registration, see lib/managed-agents-client.ts) ──
# Investigator agent ID — populated by STORY-005's registration script.
INVESTIGATOR_AGENT_ID=
# Researcher agent ID — populated by STORY-017's registration script.
RESEARCHER_AGENT_ID=
# Cloud environment ID with pip:[openpyxl,pandas] — provisioned once.
MANAGED_AGENTS_ENVIRONMENT_ID=
# Leaf runtime switch (STORY-003). v1 = legacy prompt chains, v2 = Managed
# Agents. Defaults to v1 so existing demos remain runnable.
LEAF_RUNTIME=v1

# Optional model overrides for the registration scripts. Defaults are
# claude-opus-4-7 (Investigator) and claude-sonnet-4-6 (Researcher) per
# spec-v2.md §3. Override to Haiku 4.5 for cheap plumbing-only smoke
# tests where output quality doesn't matter:
#   INVESTIGATOR_MODEL=claude-haiku-4-5
#   RESEARCHER_MODEL=claude-haiku-4-5
# Read at registration time only — changing these does not affect already-
# registered agents. After flipping, unset the corresponding *_AGENT_ID and
# re-run the registration script.
INVESTIGATOR_MODEL=
RESEARCHER_MODEL=

# ─── Embeddings (OpenAI text-embedding-3-small → 1536-dim, matches schema) ───
OPENAI_API_KEY=

# ─── Web search ──────────────────────────────────────────────────────────────
TAVILY_API_KEY=
