# ─── InsForge ────────────────────────────────────────────────────────────────
# Project linked in .insforge/project.json (oss_host + ANON_KEY).
# Fetch ANON_KEY: npx @insforge/cli secrets get ANON_KEY
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Server-only admin key. Equivalent to a service role key — never expose to client.
# Mostly unused at runtime; the CLI handles migrations and admin ops.
INSFORGE_API_KEY=

# ─── LLM access (OpenRouter — locked per Q1, 2026-05-05) ─────────────────────
OPENROUTER_API_KEY=

# Anthropic direct (optional — used only when prompt caching is worth bypassing
# OpenRouter for Sonnet/Opus). lib/llm-client.ts prefers OpenRouter by default.
ANTHROPIC_API_KEY=

# ─── Embeddings (OpenAI text-embedding-3-small → 1536-dim, matches schema) ───
OPENAI_API_KEY=

# ─── Web search ──────────────────────────────────────────────────────────────
TAVILY_API_KEY=
